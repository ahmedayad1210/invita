SUPABASE_URL=https://xlwpnodyighqpepfaekh.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://xlwpnodyighqpepfaekh.supabase.co/auth/v1/.well-known/jwks.json

# Next.js (NEXT_PUBLIC_* required for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://xlwpnodyighqpepfaekh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT anon key — use publishable OR anon (both supported)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App — use the same production URL for both
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin JWT (generate a long random string)
ADMIN_JWT_SECRET=
ADMIN_USERNAME=management@invitadrips.com
# Generate: node -e "require('bcryptjs').hash('your-password',12).then(console.log)"
ADMIN_PASSWORD_HASH=

# Media library — run supabase/media-assets.sql in Supabase SQL Editor

# Respond.io WhatsApp (optional — booking confirm + reminders)
RESPOND_IO_API_TOKEN=
RESPOND_IO_CHANNEL_ID=
RESPOND_IO_BASE_URL=https://api.respond.io/v2

# Cron — Netlify scheduled function auth for /api/cron/dispatch-notifications
# and /api/cron/make-watchdog
CRON_SECRET=

# Make.com watchdog — keeps scenarios alive + alerts when they break.
# Run supabase/make-watchdog.sql once, then set:
MAKE_API_TOKEN=              # Make → Profile → API → Add token (scenarios:read + scenarios:write)
MAKE_ZONE=us2                # subdomain in your Make URL (us2, eu1, eu2, …)
MAKE_WATCH_SCENARIO_IDS=5109637  # comma-separated scenario IDs to keep alive
MAKE_DLQ_ALERT_THRESHOLD=25  # flag "degraded" when incomplete-execution backlog ≥ this
MAKE_ALERT_WHATSAPP=         # phone to alert (via Respond.io); blank = log only
MAKE_ALERT_REPEAT_HOURS=6    # min hours between repeat alerts while still unhealthy

# IV studio migrations — run in Supabase SQL Editor (in order):
# phase4-platform.sql, media-assets.sql, services-catalog.sql, patients-crm.sql, notifications.sql
# Then sync drip menu: npm run sync:services

# EmailJS (optional — booking confirmations + contact notifications)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
